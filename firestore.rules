rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /valou2026_players/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && slotId.matches('e[1-8]-p([1-9]|10)')
        && request.resource.data.keys().hasOnly(['id', 'name', 'team', 'slot'])
        && request.resource.data.keys().hasAll(['id', 'name', 'team', 'slot'])
        && request.resource.data.id == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.team is int
        && request.resource.data.team >= 1
        && request.resource.data.team <= 8
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1
        && request.resource.data.slot <= 10
        && slotId == 'e' + string(request.resource.data.team) + '-p' + string(request.resource.data.slot);
      allow delete: if request.auth != null && resource.data.id == request.auth.uid;
      allow update: if false;
    }
  }
}
